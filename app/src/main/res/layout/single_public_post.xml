<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/layout_inside_white"
    android:elevation="30dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/layout_inside_white"
        android:elevation="20dp"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image_post"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_gravity="left"
            android:cropToPadding="true"
            android:padding="5dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/empty_profie" />

        <TextView
            android:id="@+id/username_post"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:text="Rakshit"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:text="Title "
            android:textAlignment="center" />

        <ImageView
            android:id="@+id/imageView_post"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="center|top"
            android:visibility="visible"
            app:srcCompat="@drawable/empty_profie" />

        <VideoView
            android:id="@+id/videoView3"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center|top" />
    </LinearLayout>
</LinearLayout>